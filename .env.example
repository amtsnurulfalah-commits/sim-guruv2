# Fondasi dapat dibangun tanpa layanan eksternal. Jangan isi kredensial nyata di berkas ini.
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Jakarta
# Hanya diisi setelah role database diprovision pada Tahap 1.2.
DATABASE_URL=
AUTH_DATABASE_URL=
DB_POOL_MAX=2
# CA publik Supabase dalam format PEM, multiline pada secret/config manager. Jangan menonaktifkan verifikasi TLS.
DB_SSL_CA=
# Digunakan mulai Tahap 1.3–1.5; kosong membuat kesiapan auth ditolak.
SESSION_SECRET=
AUTH_CHALLENGE_HMAC_SECRET=
AUTH_OUTBOX_ENCRYPTION_KEY=
# Digunakan pada integrasi Storage/email/job di tahap terkait.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Adapter yang tersedia: resend; isi setelah sender terverifikasi.
MAIL_PROVIDER=
MAIL_API_KEY=
# Alternatif bila memakai integrasi Resend Vercel; cukup isi salah satu API key.
RESEND_API_KEY=
MAIL_FROM=
CRON_SECRET=
# Pengiriman OTP langsung dan operator mail:deliver; LOGIN khusus hanya anggota sim_guru_worker.
WORKER_DATABASE_URL=

# Koneksi administratif terpisah untuk CLI migrasi, bukan runtime aplikasi.
MIGRATION_DATABASE_URL=
# Opsional uji native: database lokal disposable dengan nama berakhiran _test.
SIM_GURU_TEST_DATABASE_URL=

# Koneksi operator khusus anggota sim_guru_bootstrap; bukan credential auth/bisnis.
BOOTSTRAP_DATABASE_URL=

# Gmail SMTP: MAIL_PROVIDER=gmail, MAIL_FROM harus sama dengan SMTP_USER
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
# Google App Password (bukan password login)
SMTP_PASSWORD=

# reCAPTCHA v2 kotak centang pada login. Aktifkan setelah kedua key dan domain Google siap.
# Secret Key hanya di server/Vercel, jangan gunakan awalan NEXT_PUBLIC_ untuk rahasia.
# Tanpa flag: key lengkap mengaktifkan; false menonaktifkan secara eksplisit.
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
