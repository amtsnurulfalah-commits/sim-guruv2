{
  "name": "sim-guru",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=10 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:crypto && npm run test:db && npm run build",
    "env:check": "node --import tsx scripts/check-env.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "test:db": "node --conditions=react-server --import tsx --test --test-concurrency=2 tests/integration/database.test.ts tests/integration/accounts.test.ts tests/integration/auth-http.test.ts tests/integration/lifecycle.test.ts tests/integration/dashboard.test.ts tests/integration/users.test.ts tests/integration/masters.test.ts tests/integration/calendar.test.ts tests/integration/schedules.test.ts tests/integration/password-transport.test.ts tests/integration/otp-dispatch.test.ts tests/integration/activities.test.ts tests/integration/duties.test.ts tests/integration/programs.test.ts tests/integration/finance.test.ts tests/integration/operations.test.ts tests/integration/migration.test.ts",
    "test:db:native": "node --import tsx --test tests/integration/native-database.test.ts",
    "admin:bootstrap": "node --conditions=react-server --import tsx scripts/bootstrap-admin.ts",
    "test:crypto": "node --conditions=react-server --import tsx --test tests/crypto/*.test.ts",
    "auth:benchmark": "node --conditions=react-server --import tsx scripts/benchmark-password.ts",
    "db:verify-runtime": "node --conditions=react-server --import tsx scripts/verify-runtime-database.ts",
    "mail:deliver": "node --conditions=react-server --import tsx scripts/deliver-security-mail.ts",
    "test:schedules:native": "node --conditions=react-server --import tsx --test tests/integration/native-schedules-race.test.ts",
    "db:verify-mail-worker": "node --conditions=react-server --import tsx scripts/verify-mail-worker.ts",
    "migration:legacy": "node --import tsx scripts/migrate-legacy.ts",
    "backup:database": "node --import tsx scripts/backup-database.ts",
    "test:ui": "node tests/ui/verify.mjs",
    "test:navigation": "node tests/navigation/verify.mjs",
    "test:ui:support": "node tests/ui/support.mjs"
  },
  "dependencies": {
    "@next/env": "16.4.2",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "argon2": "0.45.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "decimal.js": "10.6.0",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "nodemailer": "10.1.7",
    "pdfkit": "0.20.2",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-socket": "0.2.13",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
